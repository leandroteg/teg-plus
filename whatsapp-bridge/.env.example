# ── Supabase (projeto TEG+) ──────────────────────────────────────────────────
SUPABASE_URL=https://uzfjfucrinokeuwpbeie.supabase.co
# Chave secreta (sb_secret_...) — Supabase → Settings → API keys.
# NUNCA commitar; no Easypanel vai no Environment do serviço.
SUPABASE_SERVICE_ROLE_KEY=

# ── Evolution API ────────────────────────────────────────────────────────────
# Rodando no MESMO projeto do Easypanel, use o host interno (projeto_serviço):
#   http://chamadowhatsapp_evolution-api:8080
EVOLUTION_URL=http://chamadowhatsapp_evolution-api:8080
# AUTHENTICATION_API_KEY da Evolution (Environment do serviço evolution-api).
EVOLUTION_APIKEY=
EVOLUTION_INSTANCE=teg-helpdesk

# ── Webhook (Evolution → bridge) ─────────────────────────────────────────────
# Token exigido no header x-webhook-token (configurado no webhook da instância).
# Recomendado mesmo em rede interna. Gere um valor aleatório longo.
WEBHOOK_TOKEN=
PORT=3000

# ── Comportamento do canal (defaults iguais ao worker) ───────────────────────
# Janela (min) p/ tratar nova mensagem como continuação de chamado aberto.
WHATSAPP_CONVERSA_JANELA_MIN=360
WHATSAPP_PERFIL_EXTERNO_EMAIL=whatsapp-externo@sistema.teguniao.com.br
WHATSAPP_BUCKET=ti-chamados
WHATSAPP_POLL_COMANDO_MS=4000
WHATSAPP_POLL_SAIDA_MS=10000
